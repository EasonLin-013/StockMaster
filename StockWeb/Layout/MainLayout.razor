@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body

            @* --- 優化後的手動同步工具區 --- *@
            <hr style="margin-top: 50px;" />
            <div class="card border-info mx-auto" style="max-width: 500px; background-color: #f8f9fa;">
                <div class="card-header bg-info text-white font-weight-bold">
                    🔄 數據同步工具
                </div>
                <div class="card-body text-center">
                    <p class="small text-muted">
                        系統偵測到封鎖時，請點擊下方按鈕進行手機 IP 同步。
                    </p>

                    <div class="d-grid gap-2 mb-3">
                        @* 這裡的按鈕文字會動態顯示當前代號，若無則顯示通用文字 *@
                        <button class="btn btn-outline-primary btn-sm" @onclick="OpenTwseData">
                            第一步：開啟證交所原始 JSON
                        </button>
                    </div>

                    <div class="mb-3 border-top pt-3">
                        <a class="btn btn-warning btn-sm font-weight-bold" 
                           href="javascript:(function(){var t=document.body.innerText;if(t.indexOf('msgArray')>-1){fetch('https://stockmaster-te7f.onrender.com/api/stock/manual-update',{method:'POST',headers:{'Content-Type':'application/json'},body:t}).then(e=>{if(e.ok)alert('✅ 同步成功！');else alert('❌ 同步失敗')}).catch(e=>alert('錯誤: '+e))}else alert('請先開啟證交所JSON頁面！')})();"
                           onclick="return false;">
                           【同步至 StockMaster】
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </main>
</div>

@code {
    // 移除預設 2330，改為空字串
    private string stockId { get; set; } = ""; 

    private async Task OpenTwseData()
    {
        // 技巧：利用 JS 直接去抓取畫面上那個「原本查詢框」的值
        // 假設你原本查詢框的 id 是 "stock-input" 或 class 是 "form-control"
        var currentId = await JSRuntime.InvokeAsync<string>("eval", "document.querySelector('input').value");

        if (string.IsNullOrWhiteSpace(currentId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "請先在查詢框輸入股票代號！");
            return;
        }

        // 去除非數字字元 (只保留股號)
        currentId = new string(currentId.Where(char.IsDigit).ToArray());

        string url = $"https://mis.twse.com.tw/stock/api/getStockInfo.jsp?ex_ch=tse_{currentId}.tw";
        await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
    }
}
